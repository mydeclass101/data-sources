# คัดลอกเป็นไฟล์ .env เมื่อต้องการเปลี่ยนค่า (ไม่มีไฟล์ .env ก็ใช้ได้ ค่าด้านล่างคือค่าเริ่มต้น)
# แก้แล้วรัน docker compose up -d อีกครั้ง

# port ในเครื่องเรา: เปลี่ยนเมื่อชนกับโปรแกรมอื่น (เช่น Postgres ตัวอื่นที่ใช้ 5432 อยู่)
SHOP_DB_PORT=5432
SHOP_API_PORT=8000

# ที่อยู่ไฟล์ข้อมูลร้าน (ปกติไม่ต้องแก้)
# DATA_URL=https://github.com/<owner>/<repo>/releases/download/<tag>/shop_timeline.dump
